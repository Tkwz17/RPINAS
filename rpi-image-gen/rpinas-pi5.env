RPINAS_MODEL="Raspberry Pi 5"
RPINAS_ARCH=arm64
RPINAS_SSID=RPINAS-Pi5
RPINAS_IP=192.168.4.1
RPINAS_STORAGE=/srv/rpinas/NAS
RPINAS_PROFILE=performance
RPINAS_MAX_WIFI_BAND=2.4GHz/5GHz
RPINAS_USB_STORAGE_NOTE="USB 3.0 and optional PCIe/NVMe storage are supported; active cooling is recommended for sustained NAS workloads."
RPINAS_BOARD=pi5
RPINAS_SOC=BCM2712
RPINAS_CPU_CORES=4
RPINAS_MEMORY_CLASS=4GB-16GB
RPINAS_BOOT_PROFILE=64-bit-performance-pcie
RPINAS_PRIMARY_STORAGE_BUS=USB3-or-PCIe
RPINAS_ETHERNET=gigabit
RPINAS_PCIE=enabled
