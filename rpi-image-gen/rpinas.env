RPINAS_MODEL="Raspberry Pi 4"
RPINAS_ARCH=arm64
RPINAS_SSID=RPINAS-Pi4
RPINAS_IP=192.168.4.1
RPINAS_STORAGE=/srv/rpinas/NAS
RPINAS_PROFILE=balanced
RPINAS_MAX_WIFI_BAND=2.4GHz/5GHz
RPINAS_USB_STORAGE_NOTE="USB 3.0 storage is supported; sustained NAS speed depends on cooling, power, and drive performance."
RPINAS_BOARD=pi4
RPINAS_SOC=BCM2711
RPINAS_CPU_CORES=4
RPINAS_MEMORY_CLASS=2GB-8GB
RPINAS_BOOT_PROFILE=64-bit-balanced
RPINAS_PRIMARY_STORAGE_BUS=USB3
RPINAS_ETHERNET=gigabit
RPINAS_PCIE=none
