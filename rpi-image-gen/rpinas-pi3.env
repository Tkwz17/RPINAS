RPINAS_MODEL="Raspberry Pi 3"
RPINAS_ARCH=armhf
RPINAS_SSID=RPINAS-Pi3
RPINAS_IP=192.168.4.1
RPINAS_COUNTRY=US
RPINAS_WIFI_HW_MODE=g
RPINAS_WIFI_CHANNEL=6
RPINAS_STORAGE=/srv/rpinas/NAS
RPINAS_PROFILE=low-memory
RPINAS_MAX_WIFI_BAND=2.4GHz
RPINAS_USB_STORAGE_NOTE="USB 2.0 storage and network throughput are expected limits on Pi 3."
RPINAS_BOARD=pi3
RPINAS_SOC=BCM2837
RPINAS_CPU_CORES=4
RPINAS_MEMORY_CLASS=1GB
RPINAS_BOOT_PROFILE=32-bit-low-memory
RPINAS_PRIMARY_STORAGE_BUS=USB2
RPINAS_ETHERNET=10/100
RPINAS_PCIE=none
