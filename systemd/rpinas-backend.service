[Unit]
Description=RPINAS Backend API and Admin UI
After=rpinas-firstboot.service rpinas-network-setup.service rpinas-samba-setup.service smbd.service
Wants=rpinas-network-setup.service rpinas-samba-setup.service smbd.service

[Service]
Type=simple
WorkingDirectory=/opt/rpinas
Environment=RPINAS_DB_PATH=/var/lib/rpinas/rpinas.db
ExecStart=/opt/rpinas/.venv/bin/gunicorn --factory -b 0.0.0.0:80 backend.app:create_app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
