[Unit]
Description=RPINAS First Boot Initialization
After=network.target rpinas-network-setup.service rpinas-samba-setup.service
Requires=rpinas-network-setup.service rpinas-samba-setup.service
ConditionPathExists=!/var/lib/rpinas/.first_boot_done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/rpinas-first-boot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
